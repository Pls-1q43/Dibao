{
  "manifestVersion": 1,
  "id": "app.dibao.daily-brief",
  "name": {
    "zh-CN": "每日简报",
    "en-US": "Daily Brief",
    "ja-JP": "デイリーブリーフ"
  },
  "version": "0.1.1",
  "publisher": {
    "zh-CN": "邸报",
    "en-US": "Dibao",
    "ja-JP": "Dibao"
  },
  "dibao": {
    "minVersion": "0.1.0",
    "maxVersion": "<0.4.0"
  },
  "entry": {
    "server": "server/index.mjs",
    "web": "web/index.html"
  },
  "capabilities": [
    "articles:read",
    "ranking:read",
    "settings:plugin",
    "jobs:read",
    "jobs:write",
    "files:plugin-data"
  ],
  "contributes": {
    "setupSteps": [
      {
        "id": "enable-daily-brief",
        "title": {
          "zh-CN": "每日简报",
          "en-US": "Daily Brief",
          "ja-JP": "デイリーブリーフ"
        },
        "body": {
          "zh-CN": "每天从过去 24 小时的个性化推荐中整理一份按兴趣主题分组的简报。",
          "en-US": "Create a daily digest from personalized recommendations in the past 24 hours, grouped by interest topic.",
          "ja-JP": "過去 24 時間のパーソナライズされたおすすめを、興味トピックごとに整理したデイリーブリーフを作成します。"
        },
        "order": 30,
        "defaultEnabled": true
      }
    ],
    "routes": [
      {
        "id": "daily-brief",
        "path": "daily-brief",
        "title": {
          "zh-CN": "每日简报",
          "en-US": "Daily Brief",
          "ja-JP": "デイリーブリーフ"
        },
        "panel": "web/index.html",
        "order": 45,
        "icon": "newspaper",
        "primaryNav": true,
        "primaryMobile": false
      }
    ],
    "tabs": [
      {
        "id": "daily-brief",
        "title": {
          "zh-CN": "每日简报",
          "en-US": "Daily Brief",
          "ja-JP": "デイリーブリーフ"
        },
        "slot": "app.main.nav.items",
        "route": "daily-brief",
        "order": 45,
        "icon": "newspaper",
        "primaryNav": true,
        "primaryMobile": false
      }
    ],
    "settingsTabs": [
      {
        "id": "daily-brief-settings",
        "title": {
          "zh-CN": "每日简报",
          "en-US": "Daily Brief",
          "ja-JP": "デイリーブリーフ"
        },
        "slot": "settings.tabs",
        "route": "settings",
        "order": 60,
        "icon": "newspaper"
      }
    ],
    "hooks": [
      "maintenance.tick"
    ],
    "tasks": [
      {
        "id": "dailyBrief.generate",
        "kind": "background",
        "schedule": "daily",
        "defaultEnabled": true
      }
    ]
  }
}
